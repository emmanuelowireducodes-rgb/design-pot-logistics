# Copy to the ignored repository-root .env for local development only.
# Real process environment values take precedence. Production does not load this file.
DPOT_ENV=development
DPOT_POSTGRES=1
DPOT_DEMO=0
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
# Production requires a random secret of at least 50 characters and PostgreSQL.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
PGDATABASE=postgres
PGUSER=<postgres-user>
PGPASSWORD=<postgres-password>
PGHOST=<postgres-host>
PGPORT=5432
PGSSLMODE=require

# Enable only after the domain serves HTTPS end-to-end. HSTS can persist in browsers.
DPOT_ENABLE_HSTS=0
DPOT_HSTS_SECONDS=31536000
DPOT_HSTS_SUBDOMAINS=0
DPOT_HSTS_PRELOAD=0
# Set only when a trusted reverse proxy overwrites X-Forwarded-Proto.
DPOT_TRUST_PROXY_SSL_HEADER=0

# Optional Web Push. Keep the private value in a secrets manager/environment only.
# Public/private values must be a matching VAPID P-256 key pair (base64url, no padding).
DPOT_VAPID_PUBLIC_KEY=
DPOT_VAPID_PRIVATE_KEY=
DPOT_VAPID_SUBJECT=mailto:push-operations@example.com

# Production defaults to refusing development-priced bookings. Explicit pilot opt-in:
DPOT_ALLOW_DEVELOPMENT_PRICING=0

# V1 accepts written locations and client-supplied Google Maps share links.
# No Google Maps Platform API key or Google Cloud billing is required.
# Road routing remains dormant until a provider is selected in a future phase.
ROAD_ROUTE_CACHE_SECONDS=300
